+def frozen_postlift_yaw_policy(run):
+    """Read the recognized angle guard from frozen Python AST; never execute it.
+
+    Historical helpers have the literal 15-degree guard. New helpers have one
+    immutable module constant (30) and use it in the same guard. Unknown source
+    policy shapes fail closed instead of inheriting the current live policy.
+    """
+    path=Path(run)/'source/postlift_yaw.py'
+    raw=path.read_bytes();tree=ast.parse(raw,filename=str(path))
+    functions=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='plan_postlift_yaw']
+    if len(functions)!=1:raise ValueError('Unrecognized frozen postlift helper definition')
+    name='MAX_POSTLIFT_YAW_DEGREES'
+    stores=[n for n in ast.walk(tree) if isinstance(n,ast.Name) and n.id==name and isinstance(n.ctx,ast.Store)]
+    assignments=[n for n in tree.body if isinstance(n,ast.Assign) and len(n.targets)==1 and
+                 isinstance(n.targets[0],ast.Name) and n.targets[0].id==name]
+    if stores:
+        if len(stores)!=1 or len(assignments)!=1 or not isinstance(assignments[0].value,ast.Constant) \
+                or type(assignments[0].value.value) not in (int,float) or assignments[0].value.value!=30:
+            raise ValueError('Unrecognized or reassigned frozen postlift angle constant')
+        if tree.body.index(assignments[0])>tree.body.index(functions[0]):
+            raise ValueError('Frozen postlift angle constant must precede helper definition')
+        limit=30.;expression=f'not 0 < abs(degrees) <= {name} or duration < 6'
+        mode='module_constant_30'
+    else:
+        limit=15.;expression='not 0 < abs(degrees) <= 15 or duration < 6'
+        mode='legacy_literal_15'
+    expected=ast.dump(ast.parse(expression,mode='eval').body,include_attributes=False)
+    guards=[n for n in ast.walk(functions[0]) if isinstance(n,ast.If) and
+            ast.dump(n.test,include_attributes=False)==expected]
+    if len(guards)!=1 or len(guards[0].body)!=1 or not isinstance(guards[0].body[0],ast.Raise):
+        raise ValueError('Unrecognized frozen postlift angle/duration rejection guard')
+    # The known guard is an unconditional statement within the helper's outer
+    # try body, not a nested/dead branch that merely happens to contain it.
+    outer=[n for n in functions[0].body if isinstance(n,ast.Try)]
+    if len(outer)!=1 or guards[0] not in outer[0].body:
+        raise ValueError('Frozen postlift policy guard is not on the direct validation path')
+    if any(isinstance(n,(ast.Global,ast.Nonlocal)) and name in n.names for n in ast.walk(functions[0])):
+        raise ValueError('Frozen postlift policy constant may not be rebound')
+    return dict(maximum_absolute_world_z_degrees=limit,minimum_duration_s=6.,source_form=mode,
+                source_path=str(path),source_sha256=hashlib.sha256(raw).hexdigest(),
+                extraction='Static AST recognition; frozen helper is not imported or executed')
+
